<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_dialog_top_rounded"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- iOS 顶部滑动条 -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bottom_sheet_handle"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚄 智能进站闸机核验模拟"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGateChannelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_quick_date_pill_active"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="02号 检票通道"
            android:textColor="@color/railway_blue"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGateSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="模拟铁路进站闸机「二代身份证刷证 + 动态人脸活体比对」实名核验"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- 闸机大屏仿真控制台 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#0D1929"
        app:cardCornerRadius="18dp"
        app:cardElevation="3dp"
        app:strokeColor="#26417A"
        app:strokeWidth="1.2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <!-- 顶部摄像头 & 扫描取景框 -->
            <FrameLayout
                android:id="@+id/frameGateCamera"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/bg_surface_card">

                <ImageView
                    android:id="@+id/ivGateFaceAvatar"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_default_avatar"
                    android:contentDescription="人脸取景"
                    app:tint="#6BA4DE" />

                <!-- 激光扫描线动画条 -->
                <View
                    android:id="@+id/viewGateScanLaser"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="top"
                    android:background="#00FF88" />

                <TextView
                    android:id="@+id/tvFaceCameraPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#B3000000"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:text="请正视摄像头"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- 闸机通行指示灯 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGateStatusLed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvGateStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="等待旅客放置有效身份证件"
                    android:textColor="#E0EEFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGatePassPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="闸翼关闭 · 请先刷证核验"
                android:textColor="#88A6D3"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- NFC 刷证互动感应区 -->
    <LinearLayout
        android:id="@+id/layoutTapIdCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_surface_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/ripple_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_service_temp_id"
            app:tint="@color/railway_blue"
            android:contentDescription="身份证" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGatePassengerIdName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="张三 (身份证: 110101********1234)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="👉 点击此处模拟将身份证紧贴闸机 NFC 感应区"
                android:textColor="@color/railway_blue"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 票务核验结果面板 -->
    <LinearLayout
        android:id="@+id/layoutVerificationResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_passenger_selected"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGateVerifiedTripInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="车次：G1234 次 · 03车 11A号"
            android:textColor="@color/railway_blue_deep"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGateVerifiedStationGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="检票口：南 2A 检票口 · 站台：2 站台乘车"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseGateDialog"
        style="@style/App.Button.Quiet"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="完成通过 / 关闭"
        android:textSize="14sp"
        app:cornerRadius="@dimen/corner_large" />

</LinearLayout>
