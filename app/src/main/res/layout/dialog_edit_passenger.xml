<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardBackgroundColor="#C9E8F8FF"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:strokeColor="#B8FFFFFF"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="乘车人"
                android:padding="10dp"
                android:src="@drawable/ic_passenger"
                android:tint="@color/railway_blue_deep" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPassengerDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="添加乘车人"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="实名信息仅用于购票与出行服务"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        app:cardBackgroundColor="#38FFFFFF"
        app:cardCornerRadius="@dimen/corner_large"
        app:cardElevation="0dp"
        app:strokeColor="#9FFFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/App.TextInput.Rounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="姓名"
                app:boxStrokeColor="#72C4E7FF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassengerName"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/App.TextInput.Rounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="身份证件号"
                app:boxStrokeColor="#72C4E7FF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassengerIdCard"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:inputType="textCapCharacters"
                    android:maxLength="18"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/App.TextInput.Rounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="手机号"
                app:boxStrokeColor="#72C4E7FF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassengerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:inputType="phone"
                    android:maxLength="11"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="旅客票种类型"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleTicketType"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                app:checkedButton="@id/btnTypeAdult"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeAdult"
                    style="@style/App.Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="0dp"
                    android:text="成人票"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeChild"
                    style="@style/App.Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="0dp"
                    android:text="儿童票(5折)"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeStudent"
                    style="@style/App.Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="0dp"
                    android:text="学生票(75折)"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeMilitary"
                    style="@style/App.Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="0dp"
                    android:text="残军票(5折)"
                    android:textSize="11sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/App.Button.Quiet"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="取消"
            android:textSize="15sp"
            app:cornerRadius="@dimen/corner_large" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/App.Button.Quiet"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_liquid_action"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="保存"
            android:textColor="@color/railway_blue_deep"
            android:textSize="15sp"
            app:cornerRadius="@dimen/corner_large" />
    </LinearLayout>
</LinearLayout>
