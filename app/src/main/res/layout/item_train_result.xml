<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardElevation="1dp"
    app:cardCornerRadius="20dp"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/ripple_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_train_result_glass"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 时间与车次信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDepartureTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="07:02"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvDepartureStation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="南昌西"
                    android:textSize="13.5sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- 中间的车次号和耗时 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginHorizontal="16dp">

                <TextView
                    android:id="@+id/tvTrainNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="G1759"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/railway_blue" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15分"
                    android:textSize="11.5sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvArrivalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="07:17"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvArrivalStation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="高安"
                    android:textSize="13.5sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- 价格信息 -->
            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥22起"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/railway_red"
                android:layout_marginStart="14dp" />

        </LinearLayout>

        <!-- iOS 0.5dp 发丝分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/divider"
            android:layout_marginVertical="8dp" />

        <!-- 座位余票信息 -->
        <LinearLayout
            android:id="@+id/llSeatInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:orientation="horizontal" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
