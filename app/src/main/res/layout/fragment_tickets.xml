<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_backdrop"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Full-bleed travel artwork is the backdrop for the translucent query surface. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="270dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/hero_sky"
                android:contentDescription="高铁出行插画"
                android:scaleType="centerCrop"
                android:src="@drawable/hero_railway_journey" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hero_liquid_overlay" />

            <!-- Dissolve the illustration into the page canvas before the frosted sheet begins. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="154dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_hero_fade"
                android:clickable="false"
                android:focusable="false" />

            <View
                android:id="@+id/vLiquidSheen"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_moving_sheen"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>

        <!-- iOS-style frosted travel form: content is a transparent sheet, not an opaque card. -->
        <FrameLayout
            android:id="@+id/cardTravelQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="-90dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_liquid_search_panel"
            android:clipToOutline="true"
            android:clipChildren="true">

            <!-- A dedicated abstract refraction source keeps the glass independent of the train art. -->
            <ImageView
                android:id="@+id/ivQueryGlassBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.46"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/glass_refraction_backdrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#18FFFFFF"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

            <LinearLayout
                android:id="@+id/rowDepartureDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="铁路出行"
                        android:textColor="@color/text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="选择一段舒适旅程"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_control"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etDepartureStation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="出发站"
                        android:inputType="none"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSwapStations"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_swap_stations_light"
                    android:contentDescription="互换出发站与到达站"
                    android:foreground="@drawable/ripple_glass"
                    android:padding="12dp"
                    android:src="@drawable/ic_swap_stations" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etArrivalStation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="false"
                        android:gravity="end"
                        android:hint="到达站"
                        android:inputType="none"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_glass_control"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_service_icon_glass"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_calendar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="出发日期"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etDepartureDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="false"
                        android:inputType="none"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/railway_blue"
                    android:textSize="30sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSearchTickets"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_query_action"
                android:clickable="true"
                android:contentDescription="查询车票"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="查询车票"
                    android:textColor="@color/railway_blue_deep"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="22dp"
            android:text="出行服务"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="22dp"
            android:text="餐饮、车站、酒店与更多行程服务"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnRailMeal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="高铁订餐"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_meal" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="高铁订餐" android:textColor="@color/railway_blue_deep" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnStationBoard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="车站大屏"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_station_board" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="车站大屏" android:textColor="@color/railway_blue_deep" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMultiRidePass"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="计次票"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_multi_pass" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="计次票" android:textColor="@color/railway_blue_deep" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnElectronicInvoice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="电子凭证"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_invoice" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="电子凭证" android:textColor="@color/railway_blue_deep" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnHotelBooking"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="酒店住宿"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_hotel" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="酒店住宿" android:textColor="@color/railway_blue_deep" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnStationService"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="车站服务"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_station_service" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="车站服务" android:textColor="@color/railway_blue_deep" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_glass_control"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvRecentRoutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="最近查询"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/svRecentRoutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/llRecentRoutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
