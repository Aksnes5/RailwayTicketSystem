<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_backdrop"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Full-bleed travel artwork is the backdrop for the translucent query surface. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="270dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/hero_sky"
                android:contentDescription="高铁出行插画"
                android:scaleType="centerCrop"
                android:src="@drawable/hero_railway_journey" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hero_liquid_overlay" />

            <!-- Dissolve the illustration into the page canvas before the frosted sheet begins. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="154dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_hero_fade"
                android:clickable="false"
                android:focusable="false" />

            <View
                android:id="@+id/vLiquidSheen"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_moving_sheen"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>

        <!-- iOS-style frosted travel form: content is a transparent sheet, not an opaque card. -->
        <FrameLayout
            android:id="@+id/cardTravelQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="-90dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_liquid_search_panel"
            android:clipToOutline="true"
            android:clipChildren="true">

            <!-- A dedicated abstract refraction source keeps the glass independent of the train art. -->
            <ImageView
                android:id="@+id/ivQueryGlassBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.46"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/glass_refraction_backdrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#18FFFFFF"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 实时行程灵动岛/胶囊卡片 (Apple Dynamic Island / Live Activity style) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLiveJourneyCapsule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#F4FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#59007AFF"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Top row: Live indicator + train status -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_dot_live_green" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="实时行程"
                                android:textColor="@color/green"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCapsuleStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_badge_high_speed"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="候车中 · 检票口 12A"
                                android:textColor="@color/railway_blue"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="查看详情 ›"
                                android:textColor="@color/railway_blue"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Main train number & route -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCapsuleTrainNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="G1234"
                                android:textColor="@color/railway_blue"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCapsuleRoute"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="汉口 → 天门南"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCapsuleSeat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="05车 12A号"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCapsuleCountdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="计划 07:02 发车 · 距发车还有 1小时45分"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/rowDepartureDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="铁路出行"
                            android:textColor="@color/text_primary"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="选择一段舒适旅程"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 数据源模式状态快速胶囊 -->
                    <LinearLayout
                        android:id="@+id/capsuleModeToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_data_mode_capsule"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp">

                        <View
                            android:id="@+id/vHomeModeDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_dot_live_green" />

                        <TextView
                            android:id="@+id/tvHomeModeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="官方实盘"
                            android:textColor="@color/railway_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="⇄"
                            android:textColor="@color/railway_blue"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_control"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etDepartureStation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="出发站"
                        android:inputType="none"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSwapStations"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_swap_stations_light"
                    android:contentDescription="互换出发站与到达站"
                    android:foreground="@drawable/ripple_glass"
                    android:padding="12dp"
                    android:src="@drawable/ic_swap_stations" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etArrivalStation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="false"
                        android:gravity="end"
                        android:hint="到达站"
                        android:inputType="none"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_glass_control"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_service_icon_glass"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_calendar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="出发日期"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etDepartureDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="false"
                        android:inputType="none"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnQuickToday"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_quick_date_pill_active"
                        android:gravity="center"
                        android:paddingHorizontal="9dp"
                        android:text="今天"
                        android:textColor="@color/railway_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnQuickTomorrow"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_quick_date_pill"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="明天"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/railway_blue"
                    android:textSize="26sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSearchTickets"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_query_action"
                android:clickable="true"
                android:contentDescription="查询车票"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="查询车票"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Recent routes belong to the search task, not the service launcher below. -->
            <LinearLayout
                android:id="@+id/llRecentRoutesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#42FFFFFF" />

                <TextView
                    android:id="@+id/tvRecentRoutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="最近查询"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/svRecentRoutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/llRecentRoutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="22dp"
            android:text="出行服务"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="22dp"
            android:text="餐饮、车站、酒店与更多行程服务"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnRailMeal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="高铁订餐"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_meal" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="高铁订餐" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnStationBoard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="车站大屏"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_station_board" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="车站大屏" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMultiRidePass"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="计次票"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_multi_pass" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="计次票" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnElectronicInvoice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="电子凭证"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_invoice" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="电子凭证" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnHotelBooking"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="酒店住宿"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_hotel" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="酒店住宿" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnStationService"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="车站服务"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_station_service" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="车站服务" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnBaggageCompliance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="行李自检"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_baggage" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="行李自检" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnChildDeclarationHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tile"
                android:clickable="true"
                android:contentDescription="儿童申明"
                android:focusable="true"
                android:foreground="@drawable/ripple_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <ImageView android:layout_width="33dp" android:layout_height="33dp" android:contentDescription="@null" android:padding="1dp" android:src="@drawable/ic_service_child" />
