<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_page_backdrop">

    <!-- iOS 顶部沉浸式导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackDelayQuery"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_blue_action"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="‹"
            android:textSize="26sp"
            android:textColor="@color/railway_blue"
            app:cornerRadius="20dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="列车正晚点查询"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- 搜索模式切换胶囊卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_glass_control"
                android:padding="3dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tabQueryByTrain"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="按车次查询"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_quick_date_pill_active"
                    android:textColor="@color/railway_blue" />

                <TextView
                    android:id="@+id/tabQueryByStation"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="按车站查询"
                    android:textSize="13sp"
                    android:background="@drawable/bg_quick_date_pill"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- 查询输入面板 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#70B0D8FF"
                app:cardBackgroundColor="#F8FCFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 车次输入行 -->
                    <LinearLayout
                        android:id="@+id/rowTrainInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="列车车次"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/etTrainNumber"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_glass_control"
                            android:hint="输入车次（如 G1234、D2202）"
                            android:text="G1234"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="14dp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- 车站输入行 -->
                    <LinearLayout
                        android:id="@+id/rowStationInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="查询站点"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/etStationName"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_glass_control"
                            android:hint="输入车站（如 汉口、北京西）"
                            android:text="汉口"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="15sp"
                            android:paddingHorizontal="14dp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- 到发类型切换 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="查询类型："
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnTypeArrival"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:gravity="center"
                            android:text="到达正晚点"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_quick_date_pill_active"
                            android:textColor="@color/railway_blue"
                            android:paddingHorizontal="12dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/btnTypeDeparture"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:gravity="center"
                            android:text="出发正晚点"
                            android:textSize="12sp"
                            android:background="@drawable/bg_quick_date_pill"
                            android:textColor="@color/text_secondary"
                            android:paddingHorizontal="12dp" />
                    </LinearLayout>

                    <!-- 查询按钮 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExecuteQuery"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/railway_blue"
                        android:text="查询正晚点动态"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="24dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 查询结果展示卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQueryResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#70B0D8FF"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/tvResultTrain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="G1234 次"
                            android:textColor="@color/railway_blue_deep"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvResultRoute"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="汉口 → 北京西"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/tvResultStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 正点运行"
                            android:textColor="@color/success"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_quick_date_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_surface_card"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="计划时刻"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvResultPlannedTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14:32"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="预计最新时刻"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvResultActualTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14:32 (正点)"
                                android:textColor="@color/success"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="候车检票站台"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvResultPlatform"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3 站台 / 5A 检票"
                                android:textColor="@color/railway_blue"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 动态温馨提示 -->
                    <TextView
                        android:id="@+id/tvResultPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💡 数据来源于全国铁路调度实时系统，如遇极端天气或临时调度，请以车站广播及现场大屏为准。"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 经停沿途站点正晚点列表 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="沿线各停靠站正晚点动态"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/llStopsDelayList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
