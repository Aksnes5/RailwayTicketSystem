<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">


    <!-- 路线类型选择 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="0dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDirect"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="直达"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"
            style="@style/App.Button.Quiet" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTransfer"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="中转"
            android:textSize="14sp"
            android:layout_marginStart="8dp"
            style="@style/App.Button.Quiet" />

    </LinearLayout>

    <!-- 车次列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTrains"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:layout_marginTop="0dp"
        android:clipToPadding="false"
        android:paddingBottom="72dp" />

    <!-- 底部排序栏：耗时最短 / 发时最早 / 价格最低 -->
    <LinearLayout
        android:id="@+id/sortBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingVertical="4dp"
        android:paddingHorizontal="16dp"
        android:elevation="0dp">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortShortest"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="耗时最短"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:enabled="true"
                android:onClick="onSortShortest"
                android:backgroundTint="@android:color/transparent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_sort_duration"
                app:iconGravity="textTop"
                app:iconPadding="3dp"
                app:iconSize="20dp"
                app:strokeWidth="0dp"
                style="@style/App.Button.Quiet" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortEarliest"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="发时最早"
                android:textSize="12sp"
            android:layout_marginHorizontal="8dp"
                android:clickable="true"
                android:enabled="true"
                android:onClick="onSortEarliest"
                android:backgroundTint="@android:color/transparent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_sort_departure"
                app:iconGravity="textTop"
                app:iconPadding="3dp"
                app:iconSize="20dp"
                app:strokeWidth="0dp"
                style="@style/App.Button.Quiet" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortCheapest"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="价格最低"
                android:textSize="12sp"
            android:layout_marginStart="8dp"
                android:clickable="true"
                android:enabled="true"
                android:onClick="onSortCheapest"
                android:backgroundTint="@android:color/transparent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_sort_price"
                app:iconGravity="textTop"
                app:iconPadding="3dp"
                app:iconSize="20dp"
                app:strokeWidth="0dp"
                style="@style/App.Button.Quiet" />

    </LinearLayout>

</LinearLayout>
