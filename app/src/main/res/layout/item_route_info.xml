<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@drawable/ripple_glass"
    android:clickable="true"
    android:focusable="true">

    <CheckBox
        android:id="@+id/cb_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_gravity="center_vertical" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 线路名称 -->
        <TextView
            android:id="@+id/tv_route_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="线路名称"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- 线路ID -->
        <TextView
            android:id="@+id/tv_route_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ID: ROUTE001"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />

        <!-- 车站数量和类型 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tv_station_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8 个车站"
                android:textSize="14sp"
                android:textColor="@color/colorPrimary"
                android:background="@drawable/bg_tag"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/tv_route_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="高速铁路"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tag_secondary"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

        </LinearLayout>

        <!-- 起终点站 -->
        <TextView
            android:id="@+id/tv_route_stations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="汉口 → 宜昌东"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>





