<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/railway_blue"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp">
        <ImageView android:id="@+id/btnBack" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="返回" android:src="@drawable/ic_arrow_back" android:tint="@color/white" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_weight="1" android:text="电子发票" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_glass_tint" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="电子普通发票" android:textColor="@color/railway_blue" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="仅支持为已完成行程申请开具；开具后可在本页查看票面信息。" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <com.google.android.material.textfield.TextInputLayout style="@style/App.TextInput.Rounded" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="发票抬头">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etInvoiceTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <TextView android:id="@+id/tvInvoiceHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <LinearLayout android:id="@+id/llInvoiceOrders" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
