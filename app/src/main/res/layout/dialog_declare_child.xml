<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_dialog_top_rounded"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- 顶部灰色拉条 -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bottom_sheet_handle"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👶 免费乘车儿童线上申报申明"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="依国家铁路局新规：成年旅客可免费携带一名未满6周岁且不占座儿童，需提前在线申报以便闸机直接放行。"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp" />

    <!-- 儿童姓名输入 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="儿童真实姓名"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etChildName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_control"
        android:hint="请输入乘车儿童姓名"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:singleLine="true" />

    <!-- 儿童证件号输入 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="儿童身份证号 / 出生证明编号"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etChildIdNumber"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_control"
        android:hint="输入18位身份证号或出生医学证明号"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:singleLine="true" />

    <!-- 同行成年人旅客说明 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_surface_card"
        android:padding="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAdultPassengerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="绑定同行人：主乘车人"
            android:textColor="@color/railway_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="💡 进站时成人刷身份证，儿童跟随同行人一同通过人脸/人工检票闸机，无需换取纸质车票。"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 提交按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDeclareChild"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#F2F5F8"
            android:text="取消"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:cornerRadius="23dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitDeclareChild"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="2"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/railway_blue"
            android:text="确认申报申明"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="23dp" />
    </LinearLayout>
</LinearLayout>
