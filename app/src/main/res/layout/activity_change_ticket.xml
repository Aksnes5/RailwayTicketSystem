<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_page_backdrop">

    <!-- 原订单信息 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="@dimen/corner_large"
        app:cardBackgroundColor="#B8FFFFFF"
        app:cardElevation="0dp"
        app:strokeColor="#8CFFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="原订单信息"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvOriginalTrainInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="G1 北京南 → 上海虹桥"
                android:textSize="16sp"
                android:textColor="@color/railway_blue"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvOriginalTimeInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2024-01-01 06:00 - 11:30"
                android:textSize="14sp"
                android:textColor="@color/gray_medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvOriginalSeatInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="二等座 1车 1A号"
                android:textSize="14sp"
                android:textColor="@color/gray_medium" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 日期选择 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="@dimen/corner_large"
        app:cardElevation="0dp"
        app:strokeColor="#8CFFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择改签日期"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="今天"
                android:textSize="16sp"
                android:drawableStart="@drawable/ic_calendar"
                android:drawablePadding="8dp"
                style="@style/App.Button.Quiet" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 车次列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTrains"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp" />

    <!-- 空状态提示 -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="暂无可用车次\n请选择其他日期"
        android:textSize="16sp"
        android:textColor="@color/gray_medium"
        android:gravity="center"
        android:visibility="gone" />

</LinearLayout>
