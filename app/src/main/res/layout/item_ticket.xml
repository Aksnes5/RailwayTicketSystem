<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="@dimen/corner_large"
    app:cardElevation="0dp"
    app:strokeColor="#8CFFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 车次和价格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvTrainNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="G1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/railway_blue" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥553"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/railway_red" />

        </LinearLayout>

        <!-- 出发站和到达站 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDepartureStation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="北京南"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_dark" />

                <TextView
                    android:id="@+id/tvDepartureTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:00"
                    android:textSize="14sp"
                    android:textColor="@color/gray_medium" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textSize="20sp"
                android:textColor="@color/railway_blue"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvArrivalStation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上海虹桥"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_dark" />

                <TextView
                    android:id="@+id/tvArrivalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11:30"
                    android:textSize="14sp"
                    android:textColor="@color/gray_medium" />

            </LinearLayout>

        </LinearLayout>

        <!-- 运行时间和余票 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5小时30分"
                android:textSize="14sp"
                android:textColor="@color/gray_medium" />

            <TextView
                android:id="@+id/tvAvailableSeats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="余票50张"
                android:textSize="14sp"
                android:textColor="@color/railway_blue" />

        </LinearLayout>

        <!-- 预订按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookTicket"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/book_ticket"
            android:textSize="16sp"
            app:cornerRadius="@dimen/corner_large" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
