<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Apple iOS 17 Widget Style Tile in White-Blue Palette -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="0.5dp" android:color="#DCE8F6" />
        </shape>
    </item>
    <item android:height="16dp" android:gravity="top" android:left="14dp" android:right="14dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#D9FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
