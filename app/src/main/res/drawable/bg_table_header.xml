<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#B6E9F7FF"
                android:endColor="#86C9E7FF" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
    <item android:height="14dp" android:gravity="top" android:left="18dp" android:right="18dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#7AFFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
