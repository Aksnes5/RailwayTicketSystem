<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Apple iOS Grouped Cell Card in White-Blue Palette -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="0.5dp" android:color="#DCE8F6" />
        </shape>
    </item>
    <!-- Specular Bevel Highlight on Top Edge -->
    <item android:height="20dp" android:gravity="top" android:left="18dp" android:right="18dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#E6FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>