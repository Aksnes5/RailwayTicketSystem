<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="315" android:startColor="#8AFFFFFF" android:endColor="#59D6ECFC" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
    <item android:height="18dp" android:gravity="top" android:left="20dp" android:right="20dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#80FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
