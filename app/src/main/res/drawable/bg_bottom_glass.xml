<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="30dp" android:topRightRadius="30dp" />
            <gradient android:angle="270" android:startColor="#BFFFFFFF" android:endColor="#8FE4F4FF" />
            <stroke android:width="1dp" android:color="#E0FFFFFF" />
        </shape>
    </item>
    <item android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#FFFFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
