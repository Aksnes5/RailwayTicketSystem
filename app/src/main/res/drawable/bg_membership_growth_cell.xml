<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent inset used only on the blue membership-growth surface. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#24FFFFFF" />
            <stroke android:width="1dp" android:color="#45FFFFFF" />
        </shape>
    </item>
    <item
        android:height="16dp"
        android:gravity="top"
        android:left="14dp"
        android:right="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="0"
                android:centerColor="#35FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
