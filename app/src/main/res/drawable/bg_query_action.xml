<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:angle="315" android:startColor="#62C1FF" android:centerColor="#43ADF5" android:endColor="#258FDD" />
        </shape>
    </item>
    <item android:height="16dp" android:gravity="top" android:left="34dp" android:right="34dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#70FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
