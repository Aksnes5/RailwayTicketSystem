<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="315" android:startColor="#DDF8FF" android:centerColor="#BFE9FF" android:endColor="#9FD5F8" />
            <stroke android:width="1dp" android:color="#D9FFFFFF" />
        </shape>
    </item>
    <item android:height="22dp" android:gravity="top" android:left="28dp" android:right="28dp" android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#A6FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="bottom" android:left="26dp" android:right="26dp" android:bottom="5dp">
        <shape android:shape="rectangle"><solid android:color="#38FFFFFF" /></shape>
    </item>
</layer-list>
