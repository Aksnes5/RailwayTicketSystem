<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- One shared refraction source keeps every page on the same glass material. -->
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/glass_refraction_backdrop"
            android:tileMode="disabled" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#52F7FBFF" />
        </shape>
    </item>
    <item
        android:width="430dp"
        android:height="430dp"
        android:gravity="top|start"
        android:left="-110dp"
        android:top="-150dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#23BAE7FF"
                android:endColor="#00CDEBFF"
                android:gradientRadius="245dp"
                android:startColor="#46A8DBFF"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="510dp"
        android:height="510dp"
        android:gravity="bottom|end"
        android:right="-185dp"
        android:bottom="-230dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#19B7DFFF"
                android:endColor="#00C5DCFF"
                android:gradientRadius="285dp"
                android:startColor="#2FD5E9FF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
