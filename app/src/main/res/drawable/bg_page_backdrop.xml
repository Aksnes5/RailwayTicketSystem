<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The base remains calm enough for long lists, while two soft glows make cards feel layered. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FBFDFF"
                android:centerColor="#F2F8FE"
                android:endColor="#E5F1FC" />
        </shape>
    </item>
    <item
        android:width="430dp"
        android:height="430dp"
        android:gravity="top|start"
        android:left="-110dp"
        android:top="-150dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#2EBAE7FF"
                android:endColor="#00CDEBFF"
                android:gradientRadius="245dp"
                android:startColor="#72A8DBFF"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="510dp"
        android:height="510dp"
        android:gravity="bottom|end"
        android:right="-185dp"
        android:bottom="-230dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#21B7DFFF"
                android:endColor="#00C5DCFF"
                android:gradientRadius="285dp"
                android:startColor="#44D5E9FF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
