<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Authentic Apple iOS 17/18 White & Sky Blue Luminous Canvas for Search & Results -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:centerColor="#F3F8FD"
                android:endColor="#E7F1FB" />
        </shape>
    </item>
    <item android:width="500dp" android:height="500dp" android:gravity="top|start" android:left="-120dp" android:top="-140dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="280dp"
                android:startColor="#22007AFF"
                android:centerColor="#0A007AFF"
                android:endColor="#00007AFF" />
        </shape>
    </item>
    <item android:width="450dp" android:height="450dp" android:gravity="bottom|end" android:right="-160dp" android:bottom="-140dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:startColor="#16007AFF"
                android:centerColor="#06007AFF"
                android:endColor="#00007AFF" />
        </shape>
    </item>
</layer-list>