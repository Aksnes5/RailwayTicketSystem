<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="315" android:startColor="#C4FFFFFF" android:centerColor="#B5FFFFFF" android:endColor="#91D9EFFF" />
            <stroke android:width="1dp" android:color="#D6FFFFFF" />
        </shape>
    </item>
    <item android:height="18dp" android:gravity="top" android:left="24dp" android:right="24dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#72FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
