<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="315" android:startColor="#FCFFFFFF" android:endColor="#E9F7FCFF" />
            <stroke android:width="1dp" android:color="#CFE1F0" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top" android:left="28dp" android:right="28dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
</layer-list>
