<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A translucent sheet lets the moving illustration and blue sky remain visible underneath. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient android:angle="315" android:startColor="#C9FFFFFF" android:centerColor="#B8FFFFFF" android:endColor="#A6E5F4FF" />
            <stroke android:width="1dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item android:height="46dp" android:gravity="top" android:left="28dp" android:right="28dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#C0FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:width="170dp" android:height="170dp" android:gravity="bottom|end" android:right="-62dp" android:bottom="-78dp">
        <shape android:shape="oval">
            <gradient android:startColor="#4DC8EBFF" android:endColor="#00C8EBFF" android:gradientRadius="94dp" android:type="radial" />
        </shape>
    </item>
</layer-list>
