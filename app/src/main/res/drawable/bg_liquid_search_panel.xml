<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Authentic Apple iOS 17/18 frosted glass search container with subtle border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#FAFFFFFF"
                android:endColor="#EEF4F8FA" />
            <stroke android:width="0.5dp" android:color="#E5E5EA" />
        </shape>
    </item>
    <item android:height="36dp" android:gravity="top" android:left="16dp" android:right="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#50FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
