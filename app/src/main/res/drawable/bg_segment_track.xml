<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:angle="315" android:startColor="#8CFFFFFF" android:endColor="#66D9EEFF" />
            <stroke android:width="1dp" android:color="#BFFFFFFF" />
        </shape>
    </item>
    <item android:height="17dp" android:gravity="top" android:left="34dp" android:right="34dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#4FFFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
