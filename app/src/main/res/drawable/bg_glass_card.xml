<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#F8FBFFFF" />
            <stroke android:width="0.5dp" android:color="#DCE8F6" />
        </shape>
    </item>
    <item android:height="24dp" android:gravity="top" android:left="20dp" android:right="20dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#D9FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>