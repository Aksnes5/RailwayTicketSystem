<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="315" android:startColor="#C9FFFFFF" android:centerColor="#B8FFFFFF" android:endColor="#9BD6ECFF" />
            <stroke android:width="1dp" android:color="#E8FFFFFF" />
        </shape>
    </item>
    <item android:height="40dp" android:gravity="top" android:left="28dp" android:right="28dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#70FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
