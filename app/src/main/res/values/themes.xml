<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RailwayTicketSystem" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/railway_blue</item>
        <item name="colorPrimaryVariant">@color/railway_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/railway_orange</item>
        <item name="colorSecondaryVariant">@color/railway_red_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@drawable/bg_page_backdrop</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialButtonStyle">@style/App.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/App.Button.Quiet</item>
    </style>

    <style name="App.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">#D6EBFC</item>
        <item name="android:textColor">@color/railway_blue_deep</item>
        <item name="rippleColor">#260677D7</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- 首页查询是唯一使用实心品牌蓝的大型主操作。 -->
    <style name="App.Button.Search" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/corner_large</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/railway_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="App.Button.Quiet" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">20dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">#BFFFFFFF</item>
        <item name="android:textColor">@color/railway_blue_deep</item>
        <item name="rippleColor">#260677D7</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="App.TextInput.Rounded" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_large</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_large</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_large</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_large</item>
        <item name="boxBackgroundColor">#A6FFFFFF</item>
        <item name="boxStrokeColor">@color/glass_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="App.BottomNavigation.ActiveIndicator" parent="">
        <item name="android:color">#C6DDF2FF</item>
        <item name="android:width">68dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">8dp</item>
        <item name="shapeAppearance">@style/ShapeAppearanceOverlay.RailwayTicketSystem.Avatar</item>
    </style>

    <style name="ShapeAppearanceOverlay.RailwayTicketSystem.Avatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.RailwayTicketSystem" parent="Base.Theme.RailwayTicketSystem" />

    <style name="Theme.RailwayTicketSystem.Loading" parent="Base.Theme.RailwayTicketSystem">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
