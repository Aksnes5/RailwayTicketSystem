<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RailwayTicketSystem" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/railway_blue</item>
        <item name="colorPrimaryVariant">@color/railway_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/railway_orange</item>
        <item name="colorSecondaryVariant">@color/railway_red_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@drawable/bg_page_backdrop</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="materialButtonStyle">@style/App.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/App.Button.Quiet</item>
        <item name="materialCardViewStyle">@style/App.Card.Liquid</item>
    </style>

    <style name="App.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">999dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/railway_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- 首页查询大型主操作 CTA -->
    <style name="App.Button.Search" parent="Widget.Material3.Button">
        <item name="cornerRadius">999dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/railway_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="App.Button.Quiet" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">999dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">#14007AFF</item>
        <item name="android:textColor">@color/railway_blue</item>
        <item name="rippleColor">#26007AFF</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- iOS 风格毛玻璃卡片: 高透光、0.5dp 精致发丝边框与柔和圆角 -->
    <style name="App.Card.Liquid" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">#FFFFFF</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">#DCE8F6</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <!-- Liquid outlined fields avoid the Material filled-box underline on every form. -->
    <style name="App.TextInput.Rounded" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">#F2F8FD</item>
        <item name="boxStrokeColor">#DCE8F6</item>
        <item name="boxStrokeWidth">0.5dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- iOS Tab Bar 原生体验：去除非必要的 Material 块状指示器，采用纯净图标点亮 -->
    <style name="App.BottomNavigation.ActiveIndicator" parent="">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:width">48dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.RailwayTicketSystem.Avatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.RailwayTicketSystem" parent="Base.Theme.RailwayTicketSystem" />

    <style name="Theme.RailwayTicketSystem.Loading" parent="Base.Theme.RailwayTicketSystem">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
